{
  "name": "discord-ut-verify",
  "version": "2.0.0",
  "description": "Discord bot for verifying UT students via myut QR code — runs on Cloudflare Workers",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create discord-ut-verify",
    "db:migrate": "wrangler d1 execute discord-ut-verify --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute discord-ut-verify --local --file=schema.sql",
    "register-commands": "wrangler dev --test-scheduled",
    "secrets:set": "wrangler secret put"
  },
  "keywords": [
    "discord",
    "bot",
    "verification",
    "qr-code",
    "myut",
    "universitas-terbuka",
    "cloudflare-workers"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.87.0"
  }
}
